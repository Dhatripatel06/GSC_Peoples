# Copy to .env and fill in. Never commit .env.
# See docs/development/environment.md for the full reference.

# ---------- Local infrastructure ----------
# PostgreSQL = native PostgreSQL 18 service on localhost:5432 (no Docker).
# Redis container port (docker-compose.yml, optional)
REDIS_PORT=6379

# ---------- API (apps/api) ----------
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Dedicated HR database. Never point this at the Project or Sales databases.
# `pnpm db:setup` creates the roles and fills in both URLs for you.
# Runtime URL: least-privilege role hr_app
# postgresql://hr_app:<password>@localhost:5432/hr_db?schema=hr
DATABASE_URL=
# Migration URL: role hr_migrator (used by the Prisma CLI only, never by the running API)
# postgresql://hr_migrator:<password>@localhost:5432/hr_db?schema=hr
DIRECT_URL=

# Optional. When empty, BullMQ queues/workers are disabled (see docs/architecture/overview.md).
# Example: redis://localhost:6379
REDIS_URL=

# ---------- Authentication ----------
# "development" = local-only adapter (refused when NODE_ENV=production)
# "sso"         = Central Authentication (contract pending; fails closed until configured)
AUTH_MODE=development

# Central Authentication - fill in once the platform contract is published
CENTRAL_AUTH_BASE_URL=
CENTRAL_AUTH_JWKS_URL=
CENTRAL_AUTH_ISSUER=
CENTRAL_AUTH_AUDIENCE=

# Development adapter only: default company (tenant) for local requests
DEV_AUTH_COMPANY_ID=dev-company
# Explicit opt-in for the local dev token adapter (also needs NODE_ENV=development). Refused in production.
DEV_AUTH_ENABLED=false

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ---------- Integration tests (dedicated hr_test database) ----------
# Written by `pnpm db:test:setup`. Must point at hr_test, never hr_db.
TEST_DATABASE_URL=
TEST_DIRECT_URL=
